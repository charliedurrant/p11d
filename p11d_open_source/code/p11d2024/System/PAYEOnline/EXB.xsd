								<xsd:simpleType>
									<xsd:restriction base="exb:exb_PAYEstringType">
										<xsd:enumeration value="F">
											<xsd:annotation>
												<xsd:documentation>Diesel cars which meet Euro standard 6d</xsd:documentation>
											</xsd:annotation>
										</xsd:enumeration>
										<xsd:enumeration value="D">
											<xsd:annotation>
												<xsd:documentation>All other Diesel</xsd:documentation>
											</xsd:annotation>
										</xsd:enumeration>
										<xsd:enumeration value="A">
											<xsd:annotation>
												<xsd:documentation>All other</xsd:documentation>
											</xsd:annotation>
										</xsd:enumeration>
									</xsd:restriction>
								</xsd:simpleType>
							</xsd:element>
						</xsd:sequence>
					</xsd:complexType>
				</xsd:element>
				<xsd:element name="CO2Emissions" minOccurs="0" maxOccurs="1">
					<xsd:complexType>
						<xsd:choice minOccurs="1" maxOccurs="1">
							<xsd:sequence>
								<xsd:element name="Emissions" minOccurs="1" maxOccurs="1">
									<xsd:simpleType>
										<xsd:restriction base="xsd:nonNegativeInteger">
											<xsd:maxInclusive value="999"/>
										</xsd:restriction>
									</xsd:simpleType>
								</xsd:element>
								<xsd:element name="ZeroEmissionMileage" minOccurs="0" maxOccurs="1">
									<xsd:simpleType>
										<xsd:restriction base="xsd:nonNegativeInteger">
											<xsd:maxInclusive value="9999"/>
										</xsd:restriction>
									</xsd:simpleType>
								</xsd:element>
							</xsd:sequence>
							<xsd:element name="Before1998" minOccurs="1" maxOccurs="1">
								<xsd:simpleType>
									<xsd:restriction base="exb:exb_YesNoType">
										<xsd:enumeration value="yes">
											<xsd:annotation>
												<xsd:documentation>Car was registered before 1998</xsd:documentation>
											</xsd:annotation>
										</xsd:enumeration>
									</xsd:restriction>
								</xsd:simpleType>
							</xsd:element>
							<xsd:element name="NoApproved" minOccurs="1" maxOccurs="1">
								<xsd:simpleType>
									<xsd:restriction base="exb:exb_YesNoType">
										<xsd:enumeration value="yes">
											<xsd:annotation>
												<xsd:documentation>1998 or later car for which there is no approved CO2 emissions figure</xsd:documentation>
											</xsd:annotation>
										</xsd:enumeration>
									</xsd:restriction>
								</xsd:simpleType>
							</xsd:element>
						</xsd:choice>
					</xsd:complexType>
				</xsd:element>
				<xsd:element name="MonetaryDetails" minOccurs="0" maxOccurs="1">
					<xsd:complexType>
						<xsd:sequence>
							<xsd:element name="CarPrice" minOccurs="1" maxOccurs="1">
								<xsd:complexType>
									<xsd:simpleContent>
										<xsd:restriction base="exb:exb_IRnonNegativeWholeUnitsMonetaryStructure">
											<xsd:maxInclusive value="9999999.00"/>
											<xsd:minInclusive value="1.00"/>
										</xsd:restriction>
									</xsd:simpleContent>
								</xsd:complexType>
							</xsd:element>
							<xsd:element name="AccessoriesPrice" minOccurs="0" maxOccurs="1">
								<xsd:complexType>
									<xsd:simpleContent>
										<xsd:restriction base="exb:exb_IRnonNegativeWholeUnitsMonetaryStructure">
											<xsd:maxInclusive value="999999.00"/>
											<xsd:minInclusive value="1.00"/>
										</xsd:restriction>
									</xsd:simpleContent>
								</xsd:complexType>
							</xsd:element>
							<xsd:element name="DateFirstAvailable" type="xsd:date" minOccurs="1" maxOccurs="1"/>
							<xsd:element name="CashForgone" minOccurs="0" maxOccurs="1">
								<xsd:complexType>
									<xsd:simpleContent>
										<xsd:restriction base="exb:exb_IRnonNegativeWholeUnitsMonetaryStructure">
											<xsd:maxInclusive value="9999999.00"/>
											<xsd:minInclusive value="1.00"/>
										</xsd:restriction>
									</xsd:simpleContent>
								</xsd:complexType>
							</xsd:element>
							<xsd:element name="CapitalContributions" minOccurs="1" maxOccurs="1">
								<xsd:complexType>
									<xsd:simpleContent>
										<xsd:restriction base="exb:exb_IRnonNegativeWholeUnitsMonetaryStructure">
											<xsd:maxInclusive value="5000.00"/>
										</xsd:restriction>
									</xsd:simpleContent>
								</xsd:complexType>
							</xsd:element>
							<xsd:element name="PrivateUsePayment" minOccurs="0" maxOccurs="1">
								<xsd:complexType>
									<xsd:simpleContent>
										<xsd:extension base="exb:_intermediate_PrivateUsePayment">
											<xsd:attribute name="Interval" use="optional">
												<xsd:simpleType>
													<xsd:restriction base="exb:exb_PAYEstringType">
														<xsd:enumeration value="Y">
															<xsd:annotation>
																<xsd:documentation>Yearly</xsd:documentation>
															</xsd:annotation>
														</xsd:enumeration>
														<xsd:enumeration value="Q">
															<xsd:annotation>
																<xsd:documentation>Quarterly</xsd:documentation>
															</xsd:annotation>
														</xsd:enumeration>
														<xsd:enumeration value="M">
															<xsd:annotation>
																<xsd:documentation>Monthly</xsd:documentation>
															</xsd:annotation>
														</xsd:enumeration>
														<xsd:enumeration value="W">
															<xsd:annotation>
																<xsd:documentation>Weekly</xsd:documentation>
															</xsd:annotation>
														</xsd:enumeration>
													</xsd:restriction>
												</xsd:simpleType>
											</xsd:attribute>
										</xsd:extension>
									</xsd:simpleContent>
								</xsd:complexType>
							</xsd:element>
						</xsd:sequence>
					</xsd:complexType>
				</xsd:element>
				<xsd:element name="Fuel" minOccurs="0" maxOccurs="1">
					<xsd:complexType>
						<xsd:sequence>
							<xsd:element name="PrivateUse" type="exb:exb_YesNoType" minOccurs="1" maxOccurs="1"/>
							<xsd:element name="FuelPaidByEmployee" type="exb:exb_YesNoType" minOccurs="0" maxOccurs="1"/>
						</xsd:sequence>
					</xsd:complexType>
				</xsd:element>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:complexType name="P46CarEngineSizeType">
		<xsd:simpleContent>
			<xsd:extension base="exb:_intermediate_P46CarEngineSizeType">
				<xsd:attribute name="Category" use="required">
					<xsd:simpleType>
						<xsd:restriction base="xsd:integer">
							<xsd:enumeration value="4">
								<xsd:annotation>
									<xsd:documentation>0 - No engine size e.g. electric car</xsd:documentation>
								</xsd:annotation>
							</xsd:enumeration>
							<xsd:enumeration value="3">
								<xsd:annotation>
									<xsd:documentation>2001cc or more</xsd:documentation>
								</xsd:annotation>
							</xsd:enumeration>
							<xsd:enumeration value="2">
								<xsd:annotation>
									<xsd:documentation>1401 - 2000cc</xsd:documentation>
								</xsd:annotation>
							</xsd:enumeration>
							<xsd:enumeration value="1">
								<xsd:annotation>
									<xsd:documentation>Up to 1400cc</xsd:documentation>
								</xsd:annotation>
							</xsd:enumeration>
						</xsd:restriction>
					</xsd:simpleType>
				</xsd:attribute>
			</xsd:extension>
		</xsd:simpleContent>
	</xsd:complexType>
	<xsd:simpleType name="NINOtype">
		<xsd:restriction base="exb:exb_PAYEstringType">
			<xsd:minLength value="9"/>
			<xsd:maxLength value="9"/>
			<xsd:pattern value="([A-Z]{2}[0-9]{6}[A-D ])"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:complexType name="EXBNameStructure">
		<xsd:sequence>
			<xsd:element name="Ttl" minOccurs="0" maxOccurs="1">
				<xsd:simpleType>
					<xsd:restriction base="xsd:string">
						<xsd:minLength value="1"/>
						<xsd:maxLength value="4"/>
						<xsd:pattern value="[A-Za-z][A-Za-z&apos;\-]*"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
			<xsd:element name="Fore" minOccurs="1" maxOccurs="2">
				<xsd:simpleType>
					<xsd:restriction base="xsd:string">
						<xsd:minLength value="1"/>
						<xsd:maxLength value="35"/>
						<xsd:pattern value="[A-Za-z][A-Za-z&apos;\-]*"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
			<xsd:element name="Sur" minOccurs="1" maxOccurs="1">
				<xsd:simpleType>
					<xsd:restriction base="xsd:string">
						<xsd:minLength value="1"/>
						<xsd:maxLength value="35"/>
						<xsd:pattern value="[A-Za-z][A-Za-z0-9 ,\.\(\)/&amp;\-&apos;]*"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="exb_ContactDetailsStructure">
		<xsd:sequence>
			<xsd:element name="Name" minOccurs="0" maxOccurs="1">
				<xsd:complexType>
					<xsd:sequence>
						<xsd:element name="Ttl" minOccurs="0" maxOccurs="1">
							<xsd:simpleType>
								<xsd:restriction base="xsd:string">
									<xsd:minLength value="1"/>
									<xsd:maxLength value="4"/>
									<xsd:pattern value="[A-Za-z][A-Za-z&apos;\-]*"/>
								</xsd:restriction>
							</xsd:simpleType>
						</xsd:element>
						<xsd:element name="Fore" minOccurs="1" maxOccurs="2">
							<xsd:simpleType>
								<xsd:restriction base="xsd:string">
									<xsd:minLength value="1"/>
									<xsd:maxLength value="35"/>
									<xsd:pattern value="[A-Za-z][A-Za-z&apos;\-]*"/>
								</xsd:restriction>
							</xsd:simpleType>
						</xsd:element>
						<xsd:element name="Sur" minOccurs="1" maxOccurs="1">
							<xsd:simpleType>
								<xsd:restriction base="xsd:string">
									<xsd:minLength value="1"/>
									<xsd:maxLength value="35"/>
									<xsd:pattern value="[A-Za-z0-9 ,\.\(\)/&amp;\-&apos;]+"/>
								</xsd:restriction>
							</xsd:simpleType>
						</xsd:element>
					</xsd:sequence>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="Email" minOccurs="0" maxOccurs="unbounded">
				<xsd:complexType>
					<xsd:simpleContent>
						<xsd:extension base="exb:exb_EmailType">
							<xsd:attribute name="Type" type="exb:exb_WorkHomeType" use="optional"/>
							<xsd:attribute name="Preferred" type="exb:exb_YesNoType" use="optional"/>
						</xsd:extension>
					</xsd:simpleContent>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="Telephone" type="exb:exb_TelephoneStructure" minOccurs="0" maxOccurs="unbounded"/>
			<xsd:element name="Fax" type="exb:exb_TelephoneStructure" minOccurs="0" maxOccurs="unbounded"/>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:simpleType name="exb_EmailType">
		<xsd:restriction base="xsd:string">
			<xsd:minLength value="3"/>
			<xsd:maxLength value="254"/>
			<xsd:pattern value="[^@&apos;&lt;&gt;&quot;]+@[^@&apos;&lt;&gt;&quot;]+"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="exb_GenderType">
		<xsd:restriction base="xsd:string">
			<xsd:enumeration value="female"/>
			<xsd:enumeration value="male"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="exb_IRdecimalType">
		<xsd:restriction base="xsd:decimal">
			<xsd:pattern value="-?(([1-9][0-9]*)|0)\.[0-9]{2}"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="exb_IRheaderStringType">
		<xsd:restriction base="xsd:string">
			<xsd:pattern value="[A-Za-z0-9 &amp;&apos;\(\)\*,\-\./]*"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:complexType name="exb_IRmonetaryStructure">
		<xsd:simpleContent>
			<xsd:extension base="exb:exb_IRdecimalType">
				<xsd:attribute name="Currency" type="exb:exb_ISOcurrencyType" use="optional"/>
			</xsd:extension>
		</xsd:simpleContent>
	</xsd:complexType>
	<xsd:simpleType name="exb_IRnonNegativeDecimalType">
		<xsd:restriction base="exb:exb_IRdecimalType">
			<xsd:minInclusive value="0.00"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:complexType name="exb_IRnonNegativeMonetaryStructure">
		<xsd:simpleContent>
			<xsd:extension base="exb:exb_IRnonNegativeMonetaryType">
				<xsd:attribute name="Currency" type="exb:exb_ISOcurrencyType" use="optional"/>
			</xsd:extension>
		</xsd:simpleContent>
	</xsd:complexType>
	<xsd:simpleType name="exb_IRnonNegativeMonetaryType">
		<xsd:restriction base="exb:exb_IRdecimalType">
			<xsd:minInclusive value="0.00"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:complexType name="exb_IRnonNegativeWholeUnitsMonetaryStructure">
		<xsd:simpleContent>
			<xsd:extension base="exb:exb_IRnonNegativeWholeUnitsMonetaryType">
				<xsd:attribute name="Currency" type="exb:exb_ISOcurrencyType" use="optional"/>
			</xsd:extension>
		</xsd:simpleContent>
	</xsd:complexType>
	<xsd:simpleType name="exb_IRnonNegativeWholeUnitsMonetaryType">
		<xsd:restriction base="exb:exb_IRnonNegativeDecimalType">
			<xsd:pattern value=".*\.00"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="exb_ISOcurrencyType">
		<xsd:restriction base="xsd:string">
			<xsd:enumeration value="EUR">
				<xsd:annotation>
					<xsd:documentation>Euro</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="GBP">
				<xsd:annotation>
					<xsd:documentation>Sterling</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="exb_PAYEstringType">
		<xsd:restriction base="xsd:string">
			<xsd:pattern value="[A-Za-z0-9 ~!&quot;@#$%&amp;&apos;\(\)\*\+,\-\./:;&lt;=&gt;\?\[\\\]^_\{\}£€]*"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:complexType name="exb_TelephoneStructure">
		<xsd:sequence>
			<xsd:element name="Number" minOccurs="1" maxOccurs="1">
				<xsd:simpleType>
					<xsd:restriction base="xsd:string">
						<xsd:minLength value="1"/>
						<xsd:maxLength value="35"/>
						<xsd:pattern value="[0-9\(\)\-\s]{1,35}"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
			<xsd:element name="Extension" minOccurs="0" maxOccurs="1">
				<xsd:simpleType>
					<xsd:restriction base="xsd:string">
						<xsd:minLength value="1"/>
						<xsd:maxLength value="6"/>
						<xsd:pattern value="[0-9]{1,6}"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
		</xsd:sequence>
		<xsd:attribute name="Type" type="exb:exb_WorkHomeType" use="optional"/>
		<xsd:attribute name="Mobile" type="exb:exb_YesNoType" use="optional"/>
		<xsd:attribute name="Preferred" type="exb:exb_YesNoType" use="optional"/>
	</xsd:complexType>
	<xsd:simpleType name="exb_WorkHomeType">
		<xsd:restriction base="xsd:string">
			<xsd:enumeration value="home"/>
			<xsd:enumeration value="work"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="exb_WorksNumberType">
		<xsd:restriction base="xsd:string">
			<xsd:minLength value="1"/>
			<xsd:maxLength value="20"/>
			<xsd:pattern value="[A-Za-z0-9 ~!&quot;@#$%&amp;&apos;\(\)\*\+,\-\./:;&lt;=&gt;\?\[\\\]^_\{\}£€]*"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="exb_YesNoType">
		<xsd:restriction base="xsd:string">
			<xsd:enumeration value="no"/>
			<xsd:enumeration value="yes"/>
		</xsd:restriction>
	</xsd:simpleType>
